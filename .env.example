# Copy to .env and change the secrets. .env is git-ignored.

# Warehouse connection used by the pipeline (and to create the bundled Postgres).
# DB_HOST=postgres is the Postgres container; point it at another server to use an external warehouse.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rtv_warehouse
DB_USER=rtv
DB_PASSWORD=change-me

# Airflow metadata DB and API token signing
AIRFLOW_DB_PASSWORD=change-me-airflow
AIRFLOW_JWT_SECRET=replace-with-a-long-random-string
AIRFLOW_HOST_PORT=8080
# Linux hosts: set to the output of `id -u` so files written to ./lake and ./reports are yours
AIRFLOW_UID=50000

# Read-only login used by the Streamlit dashboard
BI_READER_PASSWORD=change-me-bi
DASHBOARD_HOST_PORT=8501

SPARK_DRIVER_MEMORY=2g
